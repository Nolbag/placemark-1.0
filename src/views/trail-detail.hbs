{{> menu active="trails"}}

<section class="section">
  <h1 class="title">{{trail.name}}</h1>

  <p>{{trail.location}}</p>
  <p>{{trail.distance}} km · {{trail.duration}} minutes</p>
  <p>{{trail.difficulty}}</p>
  <p>{{trail.category}} · {{trail.format}}</p>

  {{#if isOwner}}
    <a class="button" href="/trails/{{trail._id}}/edit">Edit trail</a>
    <form action="/trails/{{trail._id}}/delete" method="POST">
      <button class="button is-danger" type="submit">Delete trail</button>
    </form>
  {{/if}}

  <a href="/trails">Back to trails</a>
</section>