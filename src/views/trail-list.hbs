{{> menu active="trails"}}

<section class="section">
  <h1 class="title">{{title}}</h1>

  <form method="GET" action="/trails" class="box">
    <div class="field">
      <label class="label" for="category">Category</label>
      <div class="select">
        <select id="category" name="category">
          <option value="">All categories</option>
          <option value="Woodland/Forest">Woodland/Forest</option>
          <option value="Hill/Mountain">Hill/Mountain</option>
          <option value="Lakeside/Riverside">Lakeside/Riverside</option>
          <option value="Bog/Moorland">Bog/Moorland</option>
          <option value="Countryside/Farmland">Countryside/Farmland</option>
          <option value="Urban/Park">Urban/Park</option>
          <option value="Mixed/Other">Mixed/Other</option>
        </select>
      </div>
    </div>

    <div class="field">
      <label class="label" for="format">Format</label>
      <div class="select">
        <select id="format" name="format">
          <option value="">All formats</option>
          <option value="Loop">Loop</option>
          <option value="Linear">Linear</option>
          <option value="Out and Back">Out and Back</option>
        </select>
      </div>
    </div>

    <div class="field">
      <label class="label" for="difficulty">Difficulty</label>
      <div class="select">
        <select id="difficulty" name="difficulty">
          <option value="">All difficulties</option>
          <option value="Easy">Easy</option>
          <option value="Moderate">Moderate</option>
          <option value="Hard">Hard</option>
        </select>
      </div>
    </div>

    <button class="button is-link" type="submit">Apply filters</button>
    <a class="button" href="/trails">Clear</a>
  </form>

  {{> add-trail}}

  {{#each trails}}
    <article class="box">
      <h2 class="subtitle">
        <a href="/trails/{{_id}}">{{name}}</a>
      </h2>
      <p>{{location}}</p>
      <p>{{distance}} km · {{duration}} minutes</p>
      <p>{{difficulty}}</p>
      <p>{{category}} · {{format}}</p>
    </article>
  {{/each}}
</section>